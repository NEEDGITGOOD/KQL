            "name": "query-e326c464-cf9a-428e-af40-845e035c4cdc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let _LatestIncidents =\n    SecurityIncident\n    | where TimeGenerated >= {TimeRange:start}\n    | summarize arg_max(TimeGenerated, *) by IncidentName\n    | where CreatedTime between ({TimeRange:start} .. {TimeRange:end})\n    | where Severity in ({Severity}) or \"*\" in ({Severity})\n    | where \"*\" in ({Tactic}) or tostring(AdditionalData.tactics) has_any ({Tactic});\nlet _IncidentRule =\n    _LatestIncidents\n    | mv-expand RuleRef = RelatedAnalyticRuleIds to typeof(string)\n    | extend RuleId = tolower(iif(RuleRef contains \"/alertRules/\", extract(@\"/alertRules/([^/]+)$\", 1, RuleRef), RuleRef))\n    | where isnotempty(RuleId)\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    // De-duplicate incident/rule pairs without grouping by dynamic columns such as Comments or Tasks.\n    // arg_max may return dynamic columns; only the BY keys must be scalar.\n    | summarize arg_max(LastModifiedTime, *) by IncidentName, RuleId;\nlet _RuleNames =\n    SecurityAlert\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n    | extend RuleId = tolower(AlertType)\n    | where isnotempty(RuleId)\n    | summarize arg_max(TimeGenerated, AlertName, Tactics, Techniques, AlertSeverity) by RuleId\n    | project RuleId, RuleName=AlertName, RuleTactics=Tactics, RuleTechniques=Techniques;\nlet _I = _IncidentRule\n| summarize Incidents=dcount(IncidentName), Closed=dcountif(IncidentName, Status==\"Closed\"),\n            TP=dcountif(IncidentName, Classification==\"TruePositive\"),\n            BP=dcountif(IncidentName, Classification==\"BenignPositive\"),\n            FP=dcountif(IncidentName, Classification==\"FalsePositive\"),\n            Undetermined=dcountif(IncidentName, Classification==\"Undetermined\") by RuleId;\nlet _A = SecurityAlert\n| where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n| where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n| extend RuleId = tolower(AlertType)\n| where isnotempty(RuleId)\n| where \"*\" in ({Rule}) or RuleId in ({Rule})\n| where AlertSeverity in ({Severity}) or \"*\" in ({Severity})\n| where \"*\" in ({Tactic}) or tostring(Tactics) has_any ({Tactic}) | summarize Alerts=dcount(SystemAlertId), arg_max(TimeGenerated, AlertName) by RuleId | project RuleId, Alerts, AlertName;\n_I\n| join kind=fullouter _A on RuleId\n| extend RuleId=coalesce(RuleId, RuleId1), Incidents=coalesce(Incidents,0), Closed=coalesce(Closed,0), TP=coalesce(TP,0), BP=coalesce(BP,0), FP=coalesce(FP,0), Undetermined=coalesce(Undetermined,0), Alerts=coalesce(Alerts,0)\n| extend Conclusive=TP+BP+FP,\n         FPPercent=round(100.0*FP/max_of(TP+BP+FP,1),1),\n         NoisePercent=round(100.0*(FP+BP)/max_of(TP+BP+FP,1),1),\n         MaliciousYieldPercent=round(100.0*TP/max_of(TP+BP+FP,1),1),\n         ClassificationCoveragePercent=round(100.0*(TP+BP+FP)/max_of(Closed,1),1)\n| extend RuleName=coalesce(AlertName, RuleId)\n| project RuleName, RuleId, Alerts, Incidents, TP, BP, FP, Undetermined, Conclusive, FPPercent, NoisePercent, MaliciousYieldPercent, ClassificationCoveragePercent\n| order by (FP+BP) desc, NoisePercent desc\n\n| where Conclusive >= toint({MinSample})\n| where Alerts > 0\n| extend AlertsPerTP=round(todouble(Alerts)/max_of(TP,1),1), NoiseIncidents=FP+BP\n| project RuleName, Alerts, Incidents, TP, NoiseIncidents, NoisePercent, MaliciousYieldPercent, AlertsPerTP, ClassificationCoveragePercent\n| order by Alerts desc, MaliciousYieldPercent asc",
              "size": 0,
              "timeContext": {
                "durationMs": 34560000000
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
