            "customWidth": "35"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SecurityAlert\n| where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n| where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n| extend RuleId = tolower(AlertType)\n| where isnotempty(RuleId)\n| where \"*\" in ({Rule}) or RuleId in ({Rule})\n| where AlertSeverity in ({Severity}) or \"*\" in ({Severity})\n| where \"*\" in ({Tactic}) or tostring(Tactics) has_any ({Tactic})\n| extend TechniqueList=split(tostring(Techniques), \",\")\n| mv-expand Technique=TechniqueList to typeof(string)\n| extend Technique=trim(\" \", Technique)\n| where isnotempty(Technique)\n| summarize Alerts=dcount(SystemAlertId) by Technique\n| top 25 by Alerts desc",
