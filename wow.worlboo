          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let _LatestIncidents =\n    SecurityIncident\n    | where TimeGenerated >= {TimeRange:start}\n    | summarize arg_max(TimeGenerated, *) by IncidentName\n    | where CreatedTime between ({TimeRange:start} .. {TimeRange:end})\n    | where Severity in ({Severity}) or \"*\" in ({Severity})\n    | where \"*\" in ({Tactic}) or tostring(AdditionalData.tactics) has_any ({Tactic});\nlet _IncidentRule =\n    _LatestIncidents\n    | mv-expand RuleRef = RelatedAnalyticRuleIds to typeof(string)\n    | extend RuleId = tolower(iif(RuleRef contains \"/alertRules/\", extract(@\"/alertRules/([^/]+)$\", 1, RuleRef), RuleRef))\n    | where isnotempty(RuleId)\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    // De-duplicate incident/rule pairs without grouping by dynamic columns such as Comments or Tasks.\n    // arg_max may return dynamic columns; only the BY keys must be scalar.\n    | summarize arg_max(LastModifiedTime, *) by IncidentName, RuleId;\nlet _RuleNames =\n    SecurityAlert\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n    | extend RuleId = tolower(AlertType)\n    | where isnotempty(RuleId)\n    | summarize arg_max(TimeGenerated, AlertName, Tactics, Techniques, AlertSeverity) by RuleId\n    | project RuleId, RuleName=AlertName, RuleTactics=Tactics, RuleTechniques=Techniques;\nlet _Touches = SecurityIncident\n| where TimeGenerated >= {TimeRange:start}\n| where ModifiedBy !in (\"Alert Grouping\", \"Fusion\", \"Incident created from alert\")\n| where ModifiedBy !contains \"Automation rule\"\n| summarize AnalystTouchProxy=count() by IncidentName;\n_IncidentRule\n| join kind=leftouter _Touches on IncidentName\n| extend TriageMinutes=tolong((FirstModifiedTime-CreatedTime)/1m), ClosureHours=toreal((ClosedTime-CreatedTime)/1h), AnalystTouchProxy=coalesce(AnalystTouchProxy,0)\n| summarize Incidents=dcount(IncidentName), TotalTouches=sum(AnalystTouchProxy), MedianTriageMinutes=percentile(TriageMinutes,50), P90TriageMinutes=percentile(TriageMinutes,90), MedianClosureHours=percentile(ClosureHours,50) by RuleId\n| join kind=leftouter _RuleNames on RuleId\n| extend RuleName=coalesce(RuleName,RuleId), TouchesPerIncident=round(todouble(TotalTouches)/max_of(Incidents,1),2)\n| project RuleName, RuleId, Incidents, TotalTouches, TouchesPerIncident, MedianTriageMinutes, P90TriageMinutes, MedianClosureHours\n| top 25 by TotalTouches desc",
