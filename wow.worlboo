{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Detection Quality & Health\nMicrosoft Sentinel analytics-rule performance, fidelity, noise, workload and execution health. **FP % excludes Benign Positive and Undetermined; Noise % = FP + BP; Malicious yield % = TP / conclusive classifications.**"
      },
      "name": "text-612558fb-417d-4a12-ae27-999c0fbafa09"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "f7ad1d98-b864-40c1-9f0b-ccbcc0232853",
            "version": "KqlParameterItem/1.0",
            "name": "View",
            "label": "Dashboard view",
            "type": 10,
            "isRequired": true,
            "jsonData": "[{\"value\": \"Overview\", \"label\": \"Overview\", \"selected\": true}, {\"value\": \"Tuning\", \"label\": \"Tuning candidates\"}, {\"value\": \"Trends\", \"label\": \"Trends\"}, {\"value\": \"Rule\", \"label\": \"Rule drill-down\"}, {\"value\": \"Health\", \"label\": \"Health & audit\"}]",
            "typeSettings": {
              "additionalResourceOptions": []
            }
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "navigation"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "3471f131-3847-42d1-814b-154c12409171",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Incident creation time",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 2592000000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 1209600000
                },
                {
                  "durationMs": 2592000000
                },
                {
                  "durationMs": 5184000000
                },
                {
                  "durationMs": 7776000000
                },
                {
                  "durationMs": 15552000000
                }
              ],
              "allowCustom": true
            }
          },
          {
            "id": "f59aa412-465f-4f58-8d68-c6fab5a288f9",
            "version": "KqlParameterItem/1.0",
            "name": "Severity",
            "label": "Severity",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "SecurityIncident | where TimeGenerated >= {TimeRange:start} | summarize arg_max(TimeGenerated, Severity) by IncidentName | summarize Count=dcount(IncidentName) by Severity | where isnotempty(Severity) | project Value=Severity, Label=strcat(Severity, \" (\", Count, \")\") | order by Value asc",
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            },
            "timeContext": {
              "durationMs": 34560000000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "844e505a-d824-4715-8e72-300c7a250404",
            "version": "KqlParameterItem/1.0",
            "name": "Tactic",
            "label": "MITRE tactic",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "SecurityIncident | where TimeGenerated >= {TimeRange:start} | summarize arg_max(TimeGenerated, AdditionalData) by IncidentName | extend T=todynamic(AdditionalData.tactics) | mv-expand T to typeof(string) | where isnotempty(T) | summarize Count=count() by T | project Value=T, Label=strcat(T, \" (\", Count, \")\") | order by Label asc",
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            },
            "timeContext": {
              "durationMs": 34560000000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "91fb4eae-17b8-44ae-9fc7-a60d2c8f588b",
            "version": "KqlParameterItem/1.0",
            "name": "Rule",
            "label": "Analytics rule",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "let R=SecurityIncident | where TimeGenerated >= {TimeRange:start} | summarize arg_max(TimeGenerated, RelatedAnalyticRuleIds) by IncidentName | mv-expand RuleRef=RelatedAnalyticRuleIds to typeof(string) | extend RuleId=tolower(iif(RuleRef contains \"/alertRules/\", extract(@\"/alertRules/([^/]+)$\", 1, RuleRef), RuleRef)) | where isnotempty(RuleId) | distinct RuleId; R | join kind=leftouter (SecurityAlert | where TimeGenerated >= {TimeRange:start} | where ProviderName in (\"ASI Scheduled Alerts\",\"CustomAlertRule\") | extend RuleId=tolower(AlertType) | summarize arg_max(TimeGenerated, AlertName) by RuleId | project RuleId, AlertName) on RuleId | project Value=RuleId, Label=iff(isempty(AlertName), RuleId, AlertName) | order by Label asc",
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            },
            "timeContext": {
              "durationMs": 34560000000
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "12a719e3-e096-4cf5-a318-e0d5f388f04a",
            "version": "KqlParameterItem/1.0",
            "name": "MinSample",
            "label": "Min conclusive incidents",
            "type": 1,
            "isRequired": true,
            "value": "10"
          }
        ],
        "style": "above",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "filters"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## Overview\nIncident metrics use the **latest SecurityIncident record** for incidents created in the selected period. Overall incident KPIs are deduplicated even if multiple rules contributed to the same incident.",
              "style": "info"
            },
            "name": "text-b91553af-1eca-42d9-a78e-e60c3f7ef6bc"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let _LatestIncidents =\n    SecurityIncident\n    | where TimeGenerated >= {TimeRange:start}\n    | summarize arg_max(TimeGenerated, *) by IncidentName\n    | where CreatedTime between ({TimeRange:start} .. {TimeRange:end})\n    | where Severity in ({Severity}) or \"*\" in ({Severity})\n    | where \"*\" in ({Tactic}) or tostring(AdditionalData.tactics) has_any ({Tactic});\nlet _IncidentRule =\n    _LatestIncidents\n    | mv-expand RuleRef = RelatedAnalyticRuleIds to typeof(string)\n    | extend RuleId = tolower(iif(RuleRef contains \"/alertRules/\", extract(@\"/alertRules/([^/]+)$\", 1, RuleRef), RuleRef))\n    | where isnotempty(RuleId)\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    // De-duplicate incident/rule pairs without grouping by dynamic columns such as Comments or Tasks.\n    // arg_max may return dynamic columns; only the BY keys must be scalar.\n    | summarize arg_max(LastModifiedTime, *) by IncidentName, RuleId;\nlet _RuleNames =\n    SecurityAlert\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n    | extend RuleId = tolower(AlertType)\n    | where isnotempty(RuleId)\n    | summarize arg_max(TimeGenerated, AlertName, Tactics, Techniques, AlertSeverity) by RuleId\n    | project RuleId, RuleName=AlertName, RuleTactics=Tactics, RuleTechniques=Techniques;\nlet _SelectedIncidents = _IncidentRule | summarize arg_max(LastModifiedTime, *) by IncidentName;\nlet _S = _SelectedIncidents\n| summarize Incidents=dcount(IncidentName), Closed=dcountif(IncidentName, Status == \"Closed\"),\n            TP=dcountif(IncidentName, Classification == \"TruePositive\"),\n            BP=dcountif(IncidentName, Classification == \"BenignPositive\"),\n            FP=dcountif(IncidentName, Classification == \"FalsePositive\"),\n            Undetermined=dcountif(IncidentName, Classification == \"Undetermined\");\nlet _A = SecurityAlert\n| where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n| where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n| extend RuleId = tolower(AlertType)\n| where isnotempty(RuleId)\n| where \"*\" in ({Rule}) or RuleId in ({Rule})\n| where AlertSeverity in ({Severity}) or \"*\" in ({Severity})\n| where \"*\" in ({Tactic}) or tostring(Tactics) has_any ({Tactic}) | summarize Alerts=dcount(SystemAlertId);\nlet _J = _S | extend k=1 | join kind=inner (_A | extend k=1) on k\n| extend Conclusive=TP+BP+FP,\n         FPPercent=round(100.0*FP/max_of(TP+BP+FP,1),1),\n         NoisePercent=round(100.0*(FP+BP)/max_of(TP+BP+FP,1),1),\n         YieldPercent=round(100.0*TP/max_of(TP+BP+FP,1),1),\n         CoveragePercent=round(100.0*(TP+BP+FP)/max_of(Closed,1),1);\nunion\n(_J | project Metric=\"Analytics-rule incidents\", Value=todouble(Incidents)),\n(_J | project Metric=\"Alerts\", Value=todouble(Alerts)),\n(_J | project Metric=\"True positive\", Value=todouble(TP)),\n(_J | project Metric=\"Benign positive\", Value=todouble(BP)),\n(_J | project Metric=\"False positive\", Value=todouble(FP)),\n(_J | project Metric=\"Undetermined\", Value=todouble(Undetermined)),\n(_J | project Metric=\"FP %\", Value=FPPercent),\n(_J | project Metric=\"Noise %\", Value=NoisePercent),\n(_J | project Metric=\"Malicious yield %\", Value=YieldPercent),\n(_J | project Metric=\"Classification coverage %\", Value=CoveragePercent)",
              "size": 0,
              "timeContext": {
                "durationMs": 34560000000
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "title": "Detection KPIs",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "auto"
                  }
                },
                "showBorder": true,
                "size": "auto"
              }
            },
            "name": "query-73420c3e-5e5c-4c9c-ad4d-18a77e32c65f"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let _LatestIncidents =\n    SecurityIncident\n    | where TimeGenerated >= {TimeRange:start}\n    | summarize arg_max(TimeGenerated, *) by IncidentName\n    | where CreatedTime between ({TimeRange:start} .. {TimeRange:end})\n    | where Severity in ({Severity}) or \"*\" in ({Severity})\n    | where \"*\" in ({Tactic}) or tostring(AdditionalData.tactics) has_any ({Tactic});\nlet _IncidentRule =\n    _LatestIncidents\n    | mv-expand RuleRef = RelatedAnalyticRuleIds to typeof(string)\n    | extend RuleId = tolower(iif(RuleRef contains \"/alertRules/\", extract(@\"/alertRules/([^/]+)$\", 1, RuleRef), RuleRef))\n    | where isnotempty(RuleId)\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    // De-duplicate incident/rule pairs without grouping by dynamic columns such as Comments or Tasks.\n    // arg_max may return dynamic columns; only the BY keys must be scalar.\n    | summarize arg_max(LastModifiedTime, *) by IncidentName, RuleId;\nlet _RuleNames =\n    SecurityAlert\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n    | extend RuleId = tolower(AlertType)\n    | where isnotempty(RuleId)\n    | summarize arg_max(TimeGenerated, AlertName, Tactics, Techniques, AlertSeverity) by RuleId\n    | project RuleId, RuleName=AlertName, RuleTactics=Tactics, RuleTechniques=Techniques;\n_IncidentRule\n| summarize arg_max(LastModifiedTime, *) by IncidentName\n| extend Outcome=case(Classification==\"TruePositive\",\"True Positive\", Classification==\"BenignPositive\",\"Benign Positive\", Classification==\"FalsePositive\",\"False Positive\", Classification==\"Undetermined\",\"Undetermined\", Status!=\"Closed\",\"Open\", \"Unclassified\")\n| summarize Incidents=dcount(IncidentName) by Outcome\n| order by Incidents desc",
              "size": 0,
              "timeContext": {
                "durationMs": 34560000000
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "piechart",
              "title": "Incident outcomes"
            },
            "name": "query-c55d868b-6777-4a74-acfe-63a45cc50b07",
            "customWidth": "35"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let _LatestIncidents =\n    SecurityIncident\n    | where TimeGenerated >= {TimeRange:start}\n    | summarize arg_max(TimeGenerated, *) by IncidentName\n    | where CreatedTime between ({TimeRange:start} .. {TimeRange:end})\n    | where Severity in ({Severity}) or \"*\" in ({Severity})\n    | where \"*\" in ({Tactic}) or tostring(AdditionalData.tactics) has_any ({Tactic});\nlet _IncidentRule =\n    _LatestIncidents\n    | mv-expand RuleRef = RelatedAnalyticRuleIds to typeof(string)\n    | extend RuleId = tolower(iif(RuleRef contains \"/alertRules/\", extract(@\"/alertRules/([^/]+)$\", 1, RuleRef), RuleRef))\n    | where isnotempty(RuleId)\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    // De-duplicate incident/rule pairs without grouping by dynamic columns such as Comments or Tasks.\n    // arg_max may return dynamic columns; only the BY keys must be scalar.\n    | summarize arg_max(LastModifiedTime, *) by IncidentName, RuleId;\nlet _RuleNames =\n    SecurityAlert\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n    | extend RuleId = tolower(AlertType)\n    | where isnotempty(RuleId)\n    | summarize arg_max(TimeGenerated, AlertName, Tactics, Techniques, AlertSeverity) by RuleId\n    | project RuleId, RuleName=AlertName, RuleTactics=Tactics, RuleTechniques=Techniques;\nlet _I = _IncidentRule\n| summarize Incidents=dcount(IncidentName), Closed=dcountif(IncidentName, Status==\"Closed\"),\n            TP=dcountif(IncidentName, Classification==\"TruePositive\"),\n            BP=dcountif(IncidentName, Classification==\"BenignPositive\"),\n            FP=dcountif(IncidentName, Classification==\"FalsePositive\"),\n            Undetermined=dcountif(IncidentName, Classification==\"Undetermined\") by RuleId;\nlet _A = SecurityAlert\n| where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n| where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n| extend RuleId = tolower(AlertType)\n| where isnotempty(RuleId)\n| where \"*\" in ({Rule}) or RuleId in ({Rule})\n| where AlertSeverity in ({Severity}) or \"*\" in ({Severity})\n| where \"*\" in ({Tactic}) or tostring(Tactics) has_any ({Tactic}) | summarize Alerts=dcount(SystemAlertId), arg_max(TimeGenerated, AlertName) by RuleId | project RuleId, Alerts, AlertName;\n_I\n| join kind=fullouter _A on RuleId\n| extend RuleId=coalesce(RuleId, RuleId1), Incidents=coalesce(Incidents,0), Closed=coalesce(Closed,0), TP=coalesce(TP,0), BP=coalesce(BP,0), FP=coalesce(FP,0), Undetermined=coalesce(Undetermined,0), Alerts=coalesce(Alerts,0)\n| extend Conclusive=TP+BP+FP,\n         FPPercent=round(100.0*FP/max_of(TP+BP+FP,1),1),\n         NoisePercent=round(100.0*(FP+BP)/max_of(TP+BP+FP,1),1),\n         MaliciousYieldPercent=round(100.0*TP/max_of(TP+BP+FP,1),1),\n         ClassificationCoveragePercent=round(100.0*(TP+BP+FP)/max_of(Closed,1),1)\n| extend RuleName=coalesce(AlertName, RuleId)\n| project RuleName, RuleId, Alerts, Incidents, TP, BP, FP, Undetermined, Conclusive, FPPercent, NoisePercent, MaliciousYieldPercent, ClassificationCoveragePercent\n| order by (FP+BP) desc, NoisePercent desc\n\n| where Conclusive >= toint({MinSample}) | extend NoiseIncidents=FP+BP | top 15 by NoiseIncidents desc | project RuleName, Alerts, Incidents, NoiseIncidents, FP, BP, NoisePercent, MaliciousYieldPercent",
              "size": 0,
              "timeContext": {
                "durationMs": 34560000000
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "title": "Top noise-producing rules",
              "gridSettings": {
                "filter": true
              }
            },
            "name": "query-2953c91d-ae7b-49ec-83dc-5639beb920d9",
            "customWidth": "65"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let _LatestIncidents =\n    SecurityIncident\n    | where TimeGenerated >= {TimeRange:start}\n    | summarize arg_max(TimeGenerated, *) by IncidentName\n    | where CreatedTime between ({TimeRange:start} .. {TimeRange:end})\n    | where Severity in ({Severity}) or \"*\" in ({Severity})\n    | where \"*\" in ({Tactic}) or tostring(AdditionalData.tactics) has_any ({Tactic});\nlet _IncidentRule =\n    _LatestIncidents\n    | mv-expand RuleRef = RelatedAnalyticRuleIds to typeof(string)\n    | extend RuleId = tolower(iif(RuleRef contains \"/alertRules/\", extract(@\"/alertRules/([^/]+)$\", 1, RuleRef), RuleRef))\n    | where isnotempty(RuleId)\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    // De-duplicate incident/rule pairs without grouping by dynamic columns such as Comments or Tasks.\n    // arg_max may return dynamic columns; only the BY keys must be scalar.\n    | summarize arg_max(LastModifiedTime, *) by IncidentName, RuleId;\nlet _RuleNames =\n    SecurityAlert\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n    | extend RuleId = tolower(AlertType)\n    | where isnotempty(RuleId)\n    | summarize arg_max(TimeGenerated, AlertName, Tactics, Techniques, AlertSeverity) by RuleId\n    | project RuleId, RuleName=AlertName, RuleTactics=Tactics, RuleTechniques=Techniques;\nlet _I = _IncidentRule\n| summarize Incidents=dcount(IncidentName), Closed=dcountif(IncidentName, Status==\"Closed\"),\n            TP=dcountif(IncidentName, Classification==\"TruePositive\"),\n            BP=dcountif(IncidentName, Classification==\"BenignPositive\"),\n            FP=dcountif(IncidentName, Classification==\"FalsePositive\"),\n            Undetermined=dcountif(IncidentName, Classification==\"Undetermined\") by RuleId;\nlet _A = SecurityAlert\n| where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n| where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n| extend RuleId = tolower(AlertType)\n| where isnotempty(RuleId)\n| where \"*\" in ({Rule}) or RuleId in ({Rule})\n| where AlertSeverity in ({Severity}) or \"*\" in ({Severity})\n| where \"*\" in ({Tactic}) or tostring(Tactics) has_any ({Tactic}) | summarize Alerts=dcount(SystemAlertId), arg_max(TimeGenerated, AlertName) by RuleId | project RuleId, Alerts, AlertName;\n_I\n| join kind=fullouter _A on RuleId\n| extend RuleId=coalesce(RuleId, RuleId1), Incidents=coalesce(Incidents,0), Closed=coalesce(Closed,0), TP=coalesce(TP,0), BP=coalesce(BP,0), FP=coalesce(FP,0), Undetermined=coalesce(Undetermined,0), Alerts=coalesce(Alerts,0)\n| extend Conclusive=TP+BP+FP,\n         FPPercent=round(100.0*FP/max_of(TP+BP+FP,1),1),\n         NoisePercent=round(100.0*(FP+BP)/max_of(TP+BP+FP,1),1),\n         MaliciousYieldPercent=round(100.0*TP/max_of(TP+BP+FP,1),1),\n         ClassificationCoveragePercent=round(100.0*(TP+BP+FP)/max_of(Closed,1),1)\n| extend RuleName=coalesce(AlertName, RuleId)\n| project RuleName, RuleId, Alerts, Incidents, TP, BP, FP, Undetermined, Conclusive, FPPercent, NoisePercent, MaliciousYieldPercent, ClassificationCoveragePercent\n| order by (FP+BP) desc, NoisePercent desc\n\n| where Conclusive >= toint({MinSample}) | top 15 by TP desc",
              "size": 0,
              "timeContext": {
                "durationMs": 34560000000
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "title": "Rules generating the most true positives",
              "gridSettings": {
                "filter": true
              }
            },
            "name": "query-0e34d1bc-78ea-43fb-9fb2-d1b274779b79"
          }
        ]
      },
      "name": "Overview group",
      "conditionalVisibility": {
        "parameterName": "View",
        "comparison": "isEqualTo",
        "value": "Overview"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## Tuning candidates\nPrioritize **noise volume + noise percentage + analyst effort**, not FP % alone. Multi-rule incidents inherit the incident disposition for every contributing rule, so per-rule outcomes are attribution signals rather than alert-level ground truth.",
              "style": "info"
            },
            "name": "text-542fcf5d-cf03-4867-89fc-7a2cff5c0641"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let _LatestIncidents =\n    SecurityIncident\n    | where TimeGenerated >= {TimeRange:start}\n    | summarize arg_max(TimeGenerated, *) by IncidentName\n    | where CreatedTime between ({TimeRange:start} .. {TimeRange:end})\n    | where Severity in ({Severity}) or \"*\" in ({Severity})\n    | where \"*\" in ({Tactic}) or tostring(AdditionalData.tactics) has_any ({Tactic});\nlet _IncidentRule =\n    _LatestIncidents\n    | mv-expand RuleRef = RelatedAnalyticRuleIds to typeof(string)\n    | extend RuleId = tolower(iif(RuleRef contains \"/alertRules/\", extract(@\"/alertRules/([^/]+)$\", 1, RuleRef), RuleRef))\n    | where isnotempty(RuleId)\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    // De-duplicate incident/rule pairs without grouping by dynamic columns such as Comments or Tasks.\n    // arg_max may return dynamic columns; only the BY keys must be scalar.\n    | summarize arg_max(LastModifiedTime, *) by IncidentName, RuleId;\nlet _RuleNames =\n    SecurityAlert\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n    | extend RuleId = tolower(AlertType)\n    | where isnotempty(RuleId)\n    | summarize arg_max(TimeGenerated, AlertName, Tactics, Techniques, AlertSeverity) by RuleId\n    | project RuleId, RuleName=AlertName, RuleTactics=Tactics, RuleTechniques=Techniques;\nlet _I = _IncidentRule\n| summarize Incidents=dcount(IncidentName), Closed=dcountif(IncidentName, Status==\"Closed\"),\n            TP=dcountif(IncidentName, Classification==\"TruePositive\"),\n            BP=dcountif(IncidentName, Classification==\"BenignPositive\"),\n            FP=dcountif(IncidentName, Classification==\"FalsePositive\"),\n            Undetermined=dcountif(IncidentName, Classification==\"Undetermined\") by RuleId;\nlet _A = SecurityAlert\n| where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n| where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n| extend RuleId = tolower(AlertType)\n| where isnotempty(RuleId)\n| where \"*\" in ({Rule}) or RuleId in ({Rule})\n| where AlertSeverity in ({Severity}) or \"*\" in ({Severity})\n| where \"*\" in ({Tactic}) or tostring(Tactics) has_any ({Tactic}) | summarize Alerts=dcount(SystemAlertId), arg_max(TimeGenerated, AlertName) by RuleId | project RuleId, Alerts, AlertName;\n_I\n| join kind=fullouter _A on RuleId\n| extend RuleId=coalesce(RuleId, RuleId1), Incidents=coalesce(Incidents,0), Closed=coalesce(Closed,0), TP=coalesce(TP,0), BP=coalesce(BP,0), FP=coalesce(FP,0), Undetermined=coalesce(Undetermined,0), Alerts=coalesce(Alerts,0)\n| extend Conclusive=TP+BP+FP,\n         FPPercent=round(100.0*FP/max_of(TP+BP+FP,1),1),\n         NoisePercent=round(100.0*(FP+BP)/max_of(TP+BP+FP,1),1),\n         MaliciousYieldPercent=round(100.0*TP/max_of(TP+BP+FP,1),1),\n         ClassificationCoveragePercent=round(100.0*(TP+BP+FP)/max_of(Closed,1),1)\n| extend RuleName=coalesce(AlertName, RuleId)\n| project RuleName, RuleId, Alerts, Incidents, TP, BP, FP, Undetermined, Conclusive, FPPercent, NoisePercent, MaliciousYieldPercent, ClassificationCoveragePercent\n| order by (FP+BP) desc, NoisePercent desc\n\n| where Conclusive >= toint({MinSample})",
              "size": 0,
              "timeContext": {
                "durationMs": 34560000000
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
