            "content": {
              "version": "KqlItem/1.0",
              "query": "let _LatestIncidents =\n    SecurityIncident\n    | where TimeGenerated >= {TimeRange:start}\n    | summarize arg_max(TimeGenerated, *) by IncidentName\n    | where CreatedTime between ({TimeRange:start} .. {TimeRange:end})\n    | where Severity in ({Severity}) or \"*\" in ({Severity})\n    | where \"*\" in ({Tactic}) or tostring(AdditionalData.tactics) has_any ({Tactic});\nlet _IncidentRule =\n    _LatestIncidents\n    | mv-expand RuleRef = RelatedAnalyticRuleIds to typeof(string)\n    | extend RuleId = tolower(iif(RuleRef contains \"/alertRules/\", extract(@\"/alertRules/([^/]+)$\", 1, RuleRef), RuleRef))\n    | where isnotempty(RuleId)\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    // De-duplicate incident/rule pairs without grouping by dynamic columns such as Comments or Tasks.\n    // arg_max may return dynamic columns; only the BY keys must be scalar.\n    | summarize arg_max(LastModifiedTime, *) by IncidentName, RuleId;\nlet _RuleNames =\n    SecurityAlert\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n    | extend RuleId = tolower(AlertType)\n    | where isnotempty(RuleId)\n    | summarize arg_max(TimeGenerated, AlertName, Tactics, Techniques, AlertSeverity) by RuleId\n    | project RuleId, RuleName=AlertName, RuleTactics=Tactics, RuleTechniques=Techniques;\n_IncidentRule\n| join kind=leftouter _RuleNames on RuleId\n| extend RuleName=coalesce(RuleName,RuleId), TriageMinutes=round(toreal((FirstModifiedTime-CreatedTime)/1m),1), ClosureHours=round(toreal((ClosedTime-CreatedTime)/1h),1), CommentCount=array_length(Comments), TaskCount=array_length(Tasks)\n| project CreatedTime, RuleName, IncidentNumber, Title, Severity, Status, Classification, ClassificationReason, TriageMinutes, ClosureHours, CommentCount, TaskCount, IncidentUrl\n| order by CreatedTime desc\n| take 250",
              "size": 0,
              "timeContext": {
                "durationMs": 34560000000
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "title": "Recent incidents",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "IncidentUrl",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "Url",
                      "linkLabel": "Open incident >"
                    }
                  }
                ],
                "filter": true
              }
            },
            "name": "query-cacc65d3-c8f7-4f1e-a4d6-9d6d1c1f636e"
          }
        ]
      },
      "name": "Rule group",
      "conditionalVisibility": {
        "parameterName": "View",
        "comparison": "isEqualTo",
        "value": "Rule"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## Health & audit\nThese panels require Sentinel **health and audit monitoring**. If the tables are unavailable, the queries are built with fuzzy unions so the workbook remains usable, but the panels may be empty. Health/audit data is not retroactive.",
              "style": "info"
            },
            "name": "text-6a9d6030-9116-44a1-b270-983361ddc87d"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\n(\n    SentinelHealth\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where SentinelResourceType =~ \"Analytics rule\"\n    | where OperationName in (\"Scheduled analytics rule run\",\"NRT analytics rule run\")\n    | extend RuleId=tolower(tostring(ExtendedProperties[\"RuleId\"])),\n             AlertsGenerated=toint(ExtendedProperties[\"AlertsGeneratedAmount\"]),\n             QueryResults=toint(ExtendedProperties[\"QueryResultAmount\"]),\n             EntitiesGenerated=toint(ExtendedProperties[\"EntitiesGeneratedAmount\"]),\n             EntitiesDropped=toint(ExtendedProperties[\"EntitiesDroppedDueToMappingIssuesAmount\"])\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    | summarize Runs=count(), FailedRuns=countif(Status==\"Failure\"), AlertsGenerated=sum(AlertsGenerated), QueryResults=sum(QueryResults), EntitiesGenerated=sum(EntitiesGenerated), EntitiesDropped=sum(EntitiesDropped), LastRun=max(TimeGenerated) by RuleId, RuleName=SentinelResourceName\n    | extend FailurePercent=round(100.0*FailedRuns/max_of(Runs,1),1), EntityDropPercent=round(100.0*EntitiesDropped/max_of(EntitiesGenerated+EntitiesDropped,1),1)\n    | project RuleName, RuleId, Runs, FailedRuns, FailurePercent, AlertsGenerated, QueryResults, EntitiesGenerated, EntitiesDropped, EntityDropPercent, LastRun\n),\n(datatable(RuleName:string,RuleId:string,Runs:long,FailedRuns:long,FailurePercent:real,AlertsGenerated:long,QueryResults:long,EntitiesGenerated:long,EntitiesDropped:long,EntityDropPercent:real,LastRun:datetime)[])\n| order by FailedRuns desc, EntityDropPercent desc",
              "size": 0,
              "timeContext": {
                "durationMs": 34560000000
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "title": "Analytics rule execution health",
              "gridSettings": {
                "filter": true
              }
            },
            "name": "query-c7253cb5-2c1d-41a2-b2bf-2bca4d18775f"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "union isfuzzy=true\n(\n    SentinelAudit\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where OperationName in (\"Microsoft.SecurityInsights/alertRules/Write\",\"Microsoft.SecurityInsights/alertRules/Delete\")\n    | extend RuleId=tolower(extract(@\"/alertRules/([^/]+)$\",1,tostring(ExtendedProperties[\"ResourceId\"]))),\n             Caller=tostring(ExtendedProperties[\"CallerName\"]),\n             ChangedFields=tostring(ExtendedProperties[\"ResourceDiffMemberNames\"])\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    | project TimeGenerated, RuleName=SentinelResourceName, RuleId, OperationName, Status, Caller, ChangedFields, Description\n),\n(datatable(TimeGenerated:datetime,RuleName:string,RuleId:string,OperationName:string,Status:string,Caller:string,ChangedFields:string,Description:string)[])\n| order by TimeGenerated desc\n| take 250",
              "size": 0,
              "timeContext": {
                "durationMs": 34560000000
              },
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "title": "Analytics rule changes",
              "gridSettings": {
                "filter": true
              }
            },
            "name": "query-017e2cc9-27b9-437a-abf9-c73843a9b870"
          }
        ]
      },
      "name": "Health group",
      "conditionalVisibility": {
        "parameterName": "View",
        "comparison": "isEqualTo",
        "value": "Health"
      }
    }
  ],
  "isLocked": false,
  "fromTemplateId": "sentinel-DetectionQualityHealth",
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}