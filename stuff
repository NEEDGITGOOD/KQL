              {
                "type": 3,
                "content": {
                  "version": "KqlItem/1.0",
                  "query": "union isfuzzy=true\n(\n    SentinelHealth\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where SentinelResourceType =~ \"Analytics rule\"\n    | where OperationName in (\"Scheduled analytics rule run\",\"NRT analytics rule run\")\n    | extend RuleId=tolower(tostring(ExtendedProperties[\"RuleId\"])),\n             AlertsGenerated=toint(ExtendedProperties[\"AlertsGeneratedAmount\"]),\n             QueryResults=toint(ExtendedProperties[\"QueryResultAmount\"]),\n             EntitiesGenerated=toint(ExtendedProperties[\"EntitiesGeneratedAmount\"]),\n             EntitiesDropped=toint(ExtendedProperties[\"EntitiesDroppedDueToMappingIssuesAmount\"])\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    | summarize Runs=count(), FailedRuns=countif(Status==\"Failure\"), AlertsGenerated=sum(AlertsGenerated), QueryResults=sum(QueryResults), EntitiesGenerated=sum(EntitiesGenerated), EntitiesDropped=sum(EntitiesDropped), LastRun=max(TimeGenerated) by RuleId, RuleName=SentinelResourceName\n    | extend FailurePercent=round(100.0*FailedRuns/max_of(Runs,1),1), EntityDropPercent=round(100.0*EntitiesDropped/max_of(EntitiesGenerated+EntitiesDropped,1),1)\n    | project RuleName, RuleId, Runs, FailedRuns, FailurePercent, AlertsGenerated, QueryResults, EntitiesGenerated, EntitiesDropped, EntityDropPercent, LastRun\n),\n(datatable(RuleName:string,RuleId:string,Runs:long,FailedRuns:long,FailurePercent:real,AlertsGenerated:long,QueryResults:long,EntitiesGenerated:long,EntitiesDropped:long,EntityDropPercent:real,LastRun:datetime)[])\n| order by FailedRuns desc, EntityDropPercent desc",
