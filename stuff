              {
                "type": 3,
                "content": {
                  "version": "KqlItem/1.0",
                  "query": "let _LatestIncidents =\n    SecurityIncident\n    | where TimeGenerated >= {TimeRange:start}\n    | summarize arg_max(TimeGenerated, *) by IncidentName\n    | where CreatedTime between ({TimeRange:start} .. {TimeRange:end})\n    | where Severity in ({Severity}) or \"*\" in ({Severity})\n    | where \"*\" in ({Tactic}) or tostring(AdditionalData.tactics) has_any ({Tactic});\nlet _IncidentRule =\n    _LatestIncidents\n    | mv-expand RuleRef = RelatedAnalyticRuleIds to typeof(string)\n    | extend RuleId = tolower(iif(RuleRef contains \"/alertRules/\", extract(@\"/alertRules/([^/]+)$\", 1, RuleRef), RuleRef))\n    | where isnotempty(RuleId)\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    | distinct IncidentName, IncidentNumber, RuleId, CreatedTime, ClosedTime, FirstModifiedTime, LastModifiedTime,\n               Severity, Status, Classification, ClassificationReason, ClassificationComment, IncidentUrl, Title, ModifiedBy,\n               Comments, Tasks, AdditionalData;\nlet _RuleNames =\n    SecurityAlert\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n    | extend RuleId = tolower(AlertType)\n    | where isnotempty(RuleId)\n    | summarize arg_max(TimeGenerated, AlertName, Tactics, Techniques, AlertSeverity) by RuleId\n    | project RuleId, RuleName=AlertName, RuleTactics=Tactics, RuleTechniques=Techniques;\n_IncidentRule\n| summarize arg_max(LastModifiedTime, *) by IncidentName\n| extend Outcome=case(Classification==\"TruePositive\",\"True Positive\", Classification==\"BenignPositive\",\"Benign Positive\", Classification==\"FalsePositive\",\"False Positive\", Classification==\"Undetermined\",\"Undetermined\", Status!=\"Closed\",\"Open\", \"Unclassified\")\n| summarize Incidents=dcount(IncidentName) by Outcome\n| order by Incidents desc",
                  "size": 0,
