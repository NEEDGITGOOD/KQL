              {
                "type": 1,
                "content": {
                  "json": "## Overview\nIncident metrics use the **latest SecurityIncident record** for incidents created in the selected period. Overall incident KPIs are deduplicated even if multiple rules contributed to the same incident.",
                  "style": "info"
                },
                "name": "text-60915aaa-121a-4109-a7fd-da37c62ef5bb"
              },
              {
                "type": 3,
                "content": {
                  "version": "KqlItem/1.0",
                  "query": "let _LatestIncidents =\n    SecurityIncident\n    | where TimeGenerated >= {TimeRange:start}\n    | summarize arg_max(TimeGenerated, *) by IncidentName\n    | where CreatedTime between ({TimeRange:start} .. {TimeRange:end})\n    | where Severity in ({Severity}) or \"*\" in ({Severity})\n    | where \"*\" in ({Tactic}) or tostring(AdditionalData.tactics) has_any ({Tactic});\nlet _IncidentRule =\n    _LatestIncidents\n    | mv-expand RuleRef = RelatedAnalyticRuleIds to typeof(string)\n    | extend RuleId = tolower(iif(RuleRef contains \"/alertRules/\", extract(@\"/alertRules/([^/]+)$\", 1, RuleRef), RuleRef))\n    | where isnotempty(RuleId)\n    | where \"*\" in ({Rule}) or RuleId in ({Rule})\n    | distinct IncidentName, IncidentNumber, RuleId, CreatedTime, ClosedTime, FirstModifiedTime, LastModifiedTime,\n               Severity, Status, Classification, ClassificationReason, ClassificationComment, IncidentUrl, Title, ModifiedBy,\n               Comments, Tasks, AdditionalData;\nlet _RuleNames =\n    SecurityAlert\n    | where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n    | where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n    | extend RuleId = tolower(AlertType)\n    | where isnotempty(RuleId)\n    | summarize arg_max(TimeGenerated, AlertName, Tactics, Techniques, AlertSeverity) by RuleId\n    | project RuleId, RuleName=AlertName, RuleTactics=Tactics, RuleTechniques=Techniques;\nlet _SelectedIncidents = _IncidentRule | summarize arg_max(LastModifiedTime, *) by IncidentName;\nlet _S = _SelectedIncidents\n| summarize Incidents=dcount(IncidentName), Closed=dcountif(IncidentName, Status == \"Closed\"),\n            TP=dcountif(IncidentName, Classification == \"TruePositive\"),\n            BP=dcountif(IncidentName, Classification == \"BenignPositive\"),\n            FP=dcountif(IncidentName, Classification == \"FalsePositive\"),\n            Undetermined=dcountif(IncidentName, Classification == \"Undetermined\");\nlet _A = SecurityAlert\n| where TimeGenerated between ({TimeRange:start} .. {TimeRange:end})\n| where ProviderName in (\"ASI Scheduled Alerts\", \"CustomAlertRule\")\n| extend RuleId = tolower(AlertType)\n| where isnotempty(RuleId)\n| where \"*\" in ({Rule}) or RuleId in ({Rule})\n| where AlertSeverity in ({Severity}) or \"*\" in ({Severity})\n| where \"*\" in ({Tactic}) or tostring(Tactics) has_any ({Tactic}) | summarize Alerts=dcount(SystemAlertId);\nlet _J = _S | extend k=1 | join kind=inner (_A | extend k=1) on k\n| extend Conclusive=TP+BP+FP,\n         FPPercent=round(100.0*FP/max_of(TP+BP+FP,1),1),\n         NoisePercent=round(100.0*(FP+BP)/max_of(TP+BP+FP,1),1),\n         YieldPercent=round(100.0*TP/max_of(TP+BP+FP,1),1),\n         CoveragePercent=round(100.0*(TP+BP+FP)/max_of(Closed,1),1);\nunion\n(_J | project Metric=\"Analytics-rule incidents\", Value=todouble(Incidents)),\n(_J | project Metric=\"Alerts\", Value=todouble(Alerts)),\n(_J | project Metric=\"True positive\", Value=todouble(TP)),\n(_J | project Metric=\"Benign positive\", Value=todouble(BP)),\n(_J | project Metric=\"False positive\", Value=todouble(FP)),\n(_J | project Metric=\"Undetermined\", Value=todouble(Undetermined)),\n(_J | project Metric=\"FP %\", Value=FPPercent),\n(_J | project Metric=\"Noise %\", Value=NoisePercent),\n(_J | project Metric=\"Malicious yield %\", Value=YieldPercent),\n(_J | project Metric=\"Classification coverage %\", Value=CoveragePercent)",
                  "size": 0,
                  "timeContext": {
